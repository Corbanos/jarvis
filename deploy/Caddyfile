# JARVIS front door.
#
# Plain HTTP on :80 for every name this machine answers to, and HTTPS on :443
# for the named hosts, signed by Caddy's own local CA (no public CA can vouch
# for .local names or LAN addresses).
#
#   http://jarvis.localhost   https://jarvis.localhost     this Mac only
#   http://jarvis.local       https://jarvis.local         any device on the LAN
#   http://haydens-Mac-mini.local                          any device, native Bonjour
#   http://192.168.2.87       https://192.168.2.87         any device, by address
#
# Why HTTPS at all on a LAN: browsers only expose geolocation, camera, and the
# microphone on a secure origin. Over plain http:// the HUD works but GPS reads
# "unavailable". A device trusts the site once by installing the CA from
# http://jarvis.local/jarvis-ca.crt (install-root.sh does this for the Mac).
#
# HTTP is never redirected to HTTPS, so a device that hasn't installed the CA
# keeps working — just without the secure-context features.
{
	admin off
	# Issue certificates from Caddy's internal CA for every named site.
	local_certs
	# install-root.sh trusts the CA explicitly; don't let Caddy also try to
	# (it fails without a keychain prompt and logs an error every start).
	skip_install_trust
	# Serve http:// and https:// side by side; don't force the upgrade.
	auto_https disable_redirects

	# Caddy's own runtime log (startup, config, errors).
	log {
		output file /opt/homebrew/var/log/jarvis-caddy.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# Everything a request can hit, shared by the http and https servers below.
(jarvis) {
	encode zstd gzip

	# Access log. Separate from the runtime log above: this one answers
	# "did that phone actually reach us, and what did it ask for?"
	log {
		output file /opt/homebrew/var/log/jarvis-access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}

	# The local CA's root certificate, so a phone can trust the https:// site.
	# iPhone: open this URL in Safari, allow the profile, install it under
	# Settings → Profile Downloaded, then enable it under Settings → General →
	# About → Certificate Trust Settings.
	handle /jarvis-ca.crt {
		root * /opt/homebrew/var/lib/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	# Fastify owns the API, the WebSocket hub, and library asset serving.
	# Routed straight there rather than through Next's rewrites, so WebSocket
	# upgrades and SSE chat streams aren't relayed through two proxies.
	@backend path /api/* /ws /ws/* /library/*
	handle @backend {
		reverse_proxy 127.0.0.1:7777 {
			# Stream SSE and WS through unbuffered; chat replies arrive token
			# by token rather than in one lump at the end.
			flush_interval -1
		}
	}

	# Everything else is the Next.js HUD.
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}

# Plain HTTP, any hostname.
:80 {
	import jarvis
}

# HTTPS. A certificate has to be issued *for* names, so these are listed
# explicitly. Add a name here and run deploy/reload.sh to cover it.
https://jarvis.local, https://haydens-Mac-mini.local, https://jarvis.localhost, https://localhost, https://192.168.2.87 {
	import jarvis
}
